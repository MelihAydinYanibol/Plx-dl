# Copy this file to .env and fill it in.

# Folder your Plex music library lives in (songs are filed as <album>/<artist> - <song>.mp3)
DEST_BASE=

# Optional: your own Spotify API app (https://developer.spotify.com/dashboard). spotdl's shared keys are used otherwise.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: where MusicBrainz Picard is installed
PICARD_PATH=C:\Program Files\MusicBrainz Picard\picard.exe

# Web app login (required to run web.py).
# WEB_PASSWORD can be plain text or a hash from: python web.py --hash-password
WEB_USERNAME=
WEB_PASSWORD=
# Optional: any long random string. Keeps you logged in across server restarts.
WEB_SECRET_KEY=OMGTHISISSOSECREEETWTFFFFFF1981298392374987aaAAAA

# How often watched playlists are checked for new songs, in minutes (minimum 5)
WATCH_INTERVAL_MINUTES=60
